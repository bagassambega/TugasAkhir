% Definisi Warna Sesuai Spesifikasi
\definecolor{rowOdd}{HTML}{FFFFFF} % Putih
\definecolor{rowEven}{HTML}{F2F2F2} % Abu-abu muda
\definecolor{headerBg}{HTML}{BEBEBE} % Abu-abu gelap

% Pembaruan Environment styledtable
\newenvironment{styledtable}[1]{%
    \renewcommand{\arraystretch}{1.25}
    % NiceTabularX secara otomatis menggantikan tabularx
    % hvlines: Otomatis menggambar SEMUA garis vertikal dan horizontal
    \NiceTabularX{\textwidth}{#1}[
        hvlines,
        cell-space-limits = 4pt, % Memberikan padding antar teks dan border
        code-before = {
            % Baris 1 (Header) diwarnai abu gelap
            \rowcolor{headerBg}{1}
            % Baris 2 ke bawah diberi warna selang-seling (Even, lalu Odd)
            \rowcolors{2}{rowEven}{rowOdd}
        }
    ]
}{%
    \endNiceTabularX
}

\usepackage{xltabular}
\usepackage{colortbl}

% Environment untuk tabel panjang yang dapat terpotong antar halaman
\newenvironment{styledxltabular}[1]{%
    \renewcommand{\arraystretch}{1.25}%
    \rowcolors{2}{rowEven}{rowOdd}%
    \xltabular{\textwidth}{#1}%
}{%
    \endxltabular%
}

